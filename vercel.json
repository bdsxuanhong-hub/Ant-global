{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "dan-kien-v7",
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/sw.js", "headers": { "Cache-Control": "public, max-age=0, must-revalidate" } },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}